---
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · TP Astro & Observable Plot</title>
	</head>
	<body class="min-h-screen bg-slate-50 text-slate-900">
		<header class="border-b border-slate-200 bg-white">
			<nav class="mx-auto flex max-w-4xl items-center gap-6 px-4 py-4" aria-label="Navigation principale">
				<a href="/" class="font-semibold">TP Astro Plot</a>
				<a href="/penguins" class="text-slate-600 hover:text-slate-900">Penguins</a>
				<a href="/examples" class="text-slate-600 hover:text-slate-900">Autres exemples</a>
			</nav>
		</header>
		<main class="mx-auto max-w-4xl px-4 py-8">
			<slot />
		</main>
	</body>
</html>
