---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from '@observablehq/plot';
import penguins from '../data/penguins.json';
---

<Layout title="Penguins">
	<h1 class="text-3xl font-bold">Exemple des penguins</h1>
	<p class="mt-4 text-slate-700">
		Jeu de données <code>penguins.json</code> ({penguins.length} manchots, colonnes utiles
		uniquement : <code>species</code>, <code>island</code>, <code>culmen_length_mm</code>,
		<code>culmen_depth_mm</code>, <code>flipper_length_mm</code>, <code>body_mass_g</code>,
		<code>sex</code>) affiché avec Observable Plot, comme dans la
		<a class="underline" href="https://observablehq.com/plot/getting-started">documentation</a>.
	</p>

	<PlotFigure
		caption="Figure 1. Longueur et profondeur du bec des manchots, par espèce."
		options={{
			title: 'Longueur et profondeur du bec des manchots',
			subtitle: 'Trois espèces de manchots de l\'archipel Palmer, Antarctique',
			caption: 'Source : palmerpenguins (Gorman, Williams & Fraser, 2014).',
			ariaLabel: 'Nuage de points de la longueur en fonction de la profondeur du bec des manchots, coloré par espèce',
			grid: true,
			color: { legend: true },
			marks: [
				Plot.dot(penguins, {
					x: 'culmen_depth_mm',
					y: 'culmen_length_mm',
					stroke: 'species',
					symbol: 'species',
				}),
			],
		}}
	/>

	<PlotFigure
		caption="Figure 2. Distribution de la masse corporelle des manchots par espèce."
		options={{
			title: 'Masse corporelle des manchots',
			ariaLabel: 'Histogramme de la masse corporelle des manchots par espèce',
			marginLeft: 60,
			marks: [
				Plot.rectY(
					penguins,
					Plot.binX({ y: 'count' }, { x: 'body_mass_g', fill: 'species' })
				),
				Plot.ruleY([0]),
			],
		}}
	/>
</Layout>
