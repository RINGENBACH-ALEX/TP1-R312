---
import logo from "../assets/logo.webp";

const annee = new Date().getFullYear();

const nav = [
	{ label: "Accueil", href: "/" },
	{ label: "Penguins", href: "/penguins" },
	{ label: "Autres exemples", href: "/examples" },
];

const liens = [
	{ label: "Dépôt du TP", href: "https://github.com/RINGENBACH-ALEX/TP1-R312" },
	{ label: "GitHub", href: "https://github.com/RINGENBACH-ALEX" },
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/alex-ringenbach/" },
];
---

<footer class="mx-auto max-w-5xl px-4 pb-10 pt-16">
	<div class="relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-[#0c0c12] p-8 sm:p-12">
		<div
			class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-crimson/25 blur-[100px]"
			aria-hidden="true"
		>
		</div>

		<div class="relative grid gap-10 sm:grid-cols-[1.4fr_1fr_1fr]">
			<div>
				<div class="flex items-center gap-3">
					<img src={logo.src} alt="" width="36" height="36" class="h-9 w-9" />
					<span class="text-xs font-semibold tracking-[.25em]">TP ASTRO PLOT</span>
				</div>
				<p class="font-display mt-6 text-2xl text-crimson">Merci d'être passé·e.</p>
				<p class="mt-3 max-w-xs text-sm leading-relaxed text-white/70">
					TP R3.12 — Astro & Observable Plot, par Alex Ringenbach, étudiant en BUT MMI.
				</p>
			</div>

			<nav aria-label="Pied de page">
				<h2 class="text-[11px] font-bold tracking-[.25em] text-white/50 uppercase">Navigation</h2>
				<ul role="list" class="mt-4 space-y-2.5 text-sm">
					{
						nav.map((item) => (
							<li>
								<a href={item.href} class="text-white/85 transition hover:text-crimson">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div>
				<h2 class="text-[11px] font-bold tracking-[.25em] text-white/50 uppercase">Liens</h2>
				<ul role="list" class="mt-4 space-y-2.5 text-sm">
					{
						liens.map((l) => (
							<li>
								<a href={l.href} target="_blank" rel="noreferrer" class="text-white/85 transition hover:text-crimson">
									{l.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div
			class="relative mt-10 flex flex-col gap-2 border-t border-white/10 pt-6 text-[10px] tracking-[.2em] text-white/50 uppercase sm:flex-row sm:items-center sm:justify-between"
		>
			<p>© {annee} Alex Ringenbach</p>
			<p>Fait avec Astro & Observable Plot</p>
		</div>
	</div>
</footer>
